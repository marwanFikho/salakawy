---
import { getContent, getVal } from '../backend/content';
import db from '../backend/db';

const c = getContent('recipe_book');

// Fetch assistant number as placeholder
let bookPhone = "+20 109 215 1540";
let whatsappNumber = "201092151540";

try {
    const contactsRow = db.prepare('SELECT content FROM site_content WHERE id = ?').get('contacts');
    if (contactsRow && contactsRow.content) {
        const contacts = JSON.parse(contactsRow.content);
        if (contacts.assistant && contacts.assistant.phone) {
            bookPhone = contacts.assistant.phone;
            whatsappNumber = bookPhone.replace(/\D/g, '');
        }
    }
} catch (e) {
    console.error("Error fetching book phone:", e);
}

const defaultQuotes = [
    "Abs are made in the kitchen.",
    "Your kitchen is your pharmacy.",
    "Transformation starts on your plate.",
    "Healthy doesn't mean boring."
];
const quotes = getVal(c, 'quotes', defaultQuotes);
---

<section class="recipe-book-section" id="recipe-book">
    <div class="container">
        <div class="book-grid">
            <!-- Book Visual -->
            <div class="book-visual-wrap fade-in-up">
                <div class="book-container">
                    <img src="/Salakawy Book.jpeg" alt="Salakawy's Secret Recipes Book Cover" class="book-cover-img" />
                    <div class="book-spine"></div>
                    <div class="book-glare"></div>
                </div>
                <div class="visual-glow"></div>
            </div>

            <!-- Book Info -->
            <div class="book-info fade-in-up delay-100">
                <div class="section-label">🍱 The Ultimate Guide</div>
                <h2 class="book-title" data-editable="recipe_book:title" set:html={getVal(c, 'title', '<span class="highlight">Yummy or Tummy</span>: Salakawy’s Recipes')} />
                
                <p class="book-desc" data-editable="recipe_book:desc" set:html={getVal(c, 'desc', 'Stop guessing what to eat. Get the exact recipes from <strong>Yummy or Tummy</strong> that I used to transform my body and the bodies of thousands of clients. Delicious, simple, and high-protein.')} />

                <div class="price-comparison">
                    <div class="price-box">
                        <span class="price-label">Investment</span>
                        <span class="price-value" data-editable="recipe_book:price" set:html={getVal(c, 'price', '290 EGP')} />
                    </div>
                    <div class="comparison-text">
                        <p>That's the price of a <strong>McDonald's meal</strong>.</p>
                        <p class="comparison-punchline">One feeds you for an hour. This transforms you for life. <br/><strong>Choose wisely.</strong></p>
                    </div>
                </div>

                <div class="quotes-slider">
                    <div class="quotes-track">
                        {quotes.map((quote) => (
                            <div class="quote-item">
                                <span class="quote-mark">“</span>
                                <p>{quote}</p>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="book-actions">
                    <a href={`https://wa.me/${whatsappNumber}?text=Hello!%20I%20want%20to%20buy%20the%20Salakawy%20Recipe%20Book.`} target="_blank" rel="noopener" class="btn btn-primary buy-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        Get It on WhatsApp
                    </a>
                    <span class="phone-label">Order now: <strong>{bookPhone}</strong></span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .recipe-book-section {
        padding: 8rem 0;
        background: radial-gradient(circle at top right, rgba(255, 255, 0, 0.05), transparent 40%),
                    radial-gradient(circle at bottom left, rgba(255, 255, 0, 0.03), transparent 30%);
        position: relative;
        overflow: hidden;
    }

    .book-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 5rem;
        align-items: center;
    }

    /* Book Visual */
    .book-visual-wrap {
        position: relative;
        perspective: 1500px;
    }

    .book-container {
        width: 100%;
        max-width: 400px;
        aspect-ratio: 3/4;
        background: #000;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 4px 12px 12px 4px;
        position: relative;
        transform: rotateY(-15deg) rotateX(5deg);
        transform-style: preserve-3d;
        box-shadow: 20px 20px 60px rgba(0,0,0,0.8),
                    0 0 40px rgba(255,255,0,0.05);
        margin: 0 auto;
        overflow: hidden;
    }

    .book-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .book-spine {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 40px;
        background: linear-gradient(to right, #000, #222, #000);
        transform: rotateY(-90deg);
        transform-origin: left;
        border-left: 1px solid rgba(255,255,255,0.1);
    }



    .book-glare {
        position: absolute;
        inset: 0;
        background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.05) 45%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 55%, transparent 60%);
        pointer-events: none;
    }

    .visual-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120%;
        height: 120%;
        background: radial-gradient(circle, rgba(255, 255, 0, 0.08) 0%, transparent 70%);
        z-index: -1;
        filter: blur(40px);
    }

    /* Info Section */
    .section-label {
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent-color);
        margin-bottom: 1rem;
    }

    .book-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        margin-bottom: 1.5rem;
        line-height: 1.1;
    }

    .book-desc {
        font-size: 1.2rem;
        color: var(--text-muted);
        margin-bottom: 2.5rem;
        max-width: 600px;
    }

    /* Price Comparison */
    .price-comparison {
        display: flex;
        gap: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 2rem;
        border-radius: 20px;
        margin-bottom: 2.5rem;
        align-items: center;
    }

    .price-box {
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        padding-right: 2rem;
    }

    .price-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
    }

    .price-value {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--accent-color);
    }

    .comparison-text p {
        margin: 0;
        font-size: 1rem;
    }

    .comparison-punchline {
        margin-top: 0.5rem !important;
        font-size: 1.1rem !important;
        color: #fff;
    }

    .comparison-punchline strong {
        color: var(--accent-color);
    }

    /* Quotes Slider (Simple Static for now) */
    .quotes-slider {
        margin-bottom: 3rem;
    }

    .quotes-track {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .quote-item {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }

    .quote-mark {
        font-size: 3rem;
        line-height: 1;
        color: var(--accent-color);
        opacity: 0.3;
        font-family: serif;
    }

    .quote-item p {
        margin: 0;
        font-style: italic;
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    /* Actions */
    .book-actions {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .buy-btn {
        gap: 10px;
        padding: 16px 32px;
        font-size: 1.1rem;
        box-shadow: 0 10px 30px rgba(255, 255, 0, 0.15);
    }

    .phone-label {
        font-size: 0.95rem;
        color: var(--text-muted);
    }

    .phone-label strong {
        color: #fff;
        margin-left: 5px;
    }

    @media (max-width: 992px) {
        .book-grid {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 3rem;
        }

        .book-desc {
            margin-left: auto;
            margin-right: auto;
        }

        .price-comparison {
            flex-direction: column;
            gap: 1rem;
        }

        .price-box {
            border-right: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-right: 0;
            padding-bottom: 1rem;
            width: 100%;
        }

        .quote-item {
            justify-content: center;
        }

        .book-actions {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>
