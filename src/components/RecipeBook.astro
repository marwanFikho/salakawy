---
import { getContent, getVal } from '../backend/content';
import db from '../backend/db';

const c = getContent('recipe_book');

let bookPhone = "+20 109 215 1540";
let whatsappNumber = "201092151540";

try {
    const contactsRow = db.prepare('SELECT content FROM site_content WHERE id = ?').get('contacts');
    if (contactsRow && contactsRow.content) {
        const contacts = JSON.parse(contactsRow.content);
        if (contacts.assistant && contacts.assistant.phone) {
            bookPhone = contacts.assistant.phone;
            whatsappNumber = bookPhone.replace(/\D/g, '');
        }
    }
} catch (e) {
    console.error("Error fetching book phone:", e);
}

const defaultQuotes = [
    "Abs are made in the kitchen.",
    "Your kitchen is your pharmacy.",
    "Transformation starts on your plate.",
    "Healthy doesn't mean boring."
];
const quotes = getVal(c, 'quotes', defaultQuotes);
---

<section class="recipe-book-section" id="recipe-book">
    <div class="container">
        <div class="book-grid">
            <!-- Book Visual -->
            <div class="book-visual-wrap fade-in-up">
                <div class="book-scene">
                    <div class="book-float-wrapper">
                        <div class="book">
                            <!-- Front cover -->
                            <div class="book-face book-face--front">
                                <img src="/Salakawy Book.jpeg" alt="Yummy or Tummy – Salakawy's Recipe Book" class="book-cover-img" />
                                <div class="book-face--front__glare"></div>
                            </div>
                            <!-- Left spine -->
                            <div class="book-face book-face--spine"></div>
                            <!-- Right pages edge -->
                            <div class="book-face book-face--pages"></div>
                            <!-- Top edge -->
                            <div class="book-face book-face--top"></div>
                            <!-- Bottom edge -->
                            <div class="book-face book-face--bottom"></div>
                            <!-- Back cover -->
                            <div class="book-face book-face--back"></div>
                        </div>
                    </div>
                </div>
                <!-- Floor shadow -->
                <div class="book-shadow"></div>
            </div>

            <!-- Book Info -->
            <div class="book-info fade-in-up delay-100">
                <div class="section-label">🍱 The Ultimate Guide</div>
                <h2 class="book-title" data-editable="recipe_book:title" set:html={getVal(c, 'title', '<span class="highlight">Yummy or Tummy</span>: Salakawy\'s Recipes')} />

                <p class="book-desc" data-editable="recipe_book:desc" set:html={getVal(c, 'desc', 'Stop guessing what to eat. Get the exact recipes from <strong>Yummy or Tummy</strong> that I used to transform my body and the bodies of thousands of clients. Delicious, simple, and high-protein.')} />

                <div class="price-comparison">
                    <div class="price-box">
                        <span class="price-label">Investment</span>
                        <span class="price-value" data-editable="recipe_book:price" set:html={getVal(c, 'price', '290 EGP')} />
                    </div>
                    <div class="comparison-text">
                        <p>That's the price of a <strong>McDonald's meal</strong>.</p>
                        <p class="comparison-punchline">One feeds you for an hour. This transforms you for life. <br/><strong>Choose wisely.</strong></p>
                    </div>
                </div>

                <div class="quotes-slider">
                    <div class="quotes-track">
                        {quotes.map((quote) => (
                            <div class="quote-item">
                                <span class="quote-mark">"</span>
                                <p>{quote}</p>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="book-actions">
                    <a href={`https://wa.me/${whatsappNumber}?text=Hello!%20I%20want%20to%20buy%20the%20Salakawy%20Recipe%20Book.`} target="_blank" rel="noopener" class="btn btn-primary buy-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        Get It on WhatsApp
                    </a>
                    <span class="phone-label">Order now: <strong>{bookPhone}</strong></span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* ── Section ─────────────────────────────────── */
    .recipe-book-section {
        padding: 8rem 0 10rem;
        background:
            radial-gradient(circle at 80% 20%, rgba(255,200,0,0.06) 0%, transparent 50%),
            radial-gradient(circle at 10% 80%, rgba(255,200,0,0.04) 0%, transparent 40%);
        position: relative;
        overflow: hidden;
    }

    .book-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 5rem;
        align-items: center;
    }

    /* ── 3D Book Scene ───────────────────────────── */
    /*
     * Book dimensions:
     *   Width  (W) = 260px  → CSS var --bw
     *   Height (H) = 370px  → CSS var --bh
     *   Depth  (D) = 40px   → CSS var --bd (half = 20px)
     */
    .book-visual-wrap {
        --bw: 260px;
        --bh: 370px;
        --bd: 40px;
        --bhr: calc(var(--bd) / 2);

        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        padding-bottom: 3rem;
    }

    .book-scene {
        perspective: 1800px;
        perspective-origin: 50% 45%;
    }

    @keyframes floatBook {
        0% { transform: translateY(0px) rotateX(0deg) rotateY(0deg); }
        50% { transform: translateY(-12px) rotateX(2deg) rotateY(-3deg); }
        100% { transform: translateY(0px) rotateX(0deg) rotateY(0deg); }
    }

    .book-float-wrapper {
        animation: floatBook 6s ease-in-out infinite;
        transform-style: preserve-3d;
    }

    .book {
        position: relative;
        width: var(--bw);
        height: var(--bh);
        transform-style: preserve-3d;
        transform: rotateX(8deg) rotateY(-28deg);
        transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
    }

    .book:hover {
        transform: rotateX(4deg) rotateY(-14deg) scale3d(1.05, 1.05, 1.05);
    }

    .book-face {
        position: absolute;
        transform-style: preserve-3d;
        backface-visibility: hidden; /* Prevent flickering on some browsers */
    }

    /* ── FRONT ───────────────────────────────────── */
    .book-face--front {
        width: var(--bw);
        height: var(--bh);
        top: 0; left: 0;
        transform: translateZ(var(--bhr));
        border-radius: 2px 6px 6px 2px;
        box-shadow: inset -3px 0 8px rgba(0,0,0,0.3);
        overflow: hidden;
    }

    .book-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .book-face--front__glare {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(255,255,255,0.18) 0%,
            rgba(255,255,255,0.06) 30%,
            transparent 55%
        );
        pointer-events: none;
    }

    /* ── BACK ────────────────────────────────────── */
    .book-face--back {
        width: var(--bw);
        height: var(--bh);
        top: 0; left: 0;
        transform: rotateY(180deg) translateZ(var(--bhr));
        background: #0a0a0a;
        border-radius: 6px 2px 2px 6px; /* Inverted for back */
        box-shadow: inset 3px 0 8px rgba(0,0,0,0.3);
    }

    /* ── SPINE (left edge) ───────────────────────── */
    .book-face--spine {
        width: var(--bd);
        height: var(--bh);
        left: 50%; top: 0;
        margin-left: calc(var(--bd) / -2);
        transform: rotateY(-90deg) translateZ(calc(var(--bw) / 2));
        background: linear-gradient(
            to right,
            #1a1208 0%,
            #3a2810 25%,
            #5a3d14 50%,
            #3a2810 75%,
            #1a1208 100%
        );
        border-radius: 2px 0 0 2px;
        box-shadow: inset -2px 0 6px rgba(0,0,0,0.5);
    }

    /* ── PAGES (right edge) ──────────────────────── */
    .book-face--pages {
        width: var(--bd);
        height: calc(var(--bh) - 4px);
        left: 50%; top: 2px;
        margin-left: calc(var(--bd) / -2);
        transform: rotateY(90deg) translateZ(calc(var(--bw) / 2 - 2px));
        background: #f2ede4;
        background-image: repeating-linear-gradient(
            to right,
            transparent 0px,
            transparent 1px,
            rgba(0,0,0,0.08) 2px,
            rgba(0,0,0,0.08) 3px
        );
        box-shadow:
            inset 0 0 12px rgba(0,0,0,0.12),
            inset 0 0 4px rgba(0,0,0,0.08);
    }

    /* ── TOP edge ────────────────────────────────── */
    .book-face--top {
        width: calc(var(--bw) - 4px);
        height: var(--bd);
        top: 50%; left: 2px;
        margin-top: calc(var(--bd) / -2);
        transform: rotateX(90deg) translateZ(calc(var(--bh) / 2 - 2px));
        background: #e8e2d8;
        background-image: repeating-linear-gradient(
            to right,
            transparent 0px,
            transparent 3px,
            rgba(0,0,0,0.05) 3px,
            rgba(0,0,0,0.05) 4px
        );
    }

    /* ── BOTTOM edge ─────────────────────────────── */
    .book-face--bottom {
        width: calc(var(--bw) - 4px);
        height: var(--bd);
        top: 50%; left: 2px;
        margin-top: calc(var(--bd) / -2);
        transform: rotateX(-90deg) translateZ(calc(var(--bh) / 2 - 2px));
        background: #e8e2d8;
        background-image: repeating-linear-gradient(
            to right,
            transparent 0px,
            transparent 3px,
            rgba(0,0,0,0.05) 3px,
            rgba(0,0,0,0.05) 4px
        );
    }

    @keyframes shadowPulse {
        0% { transform: translateX(-50%) scale(1); opacity: 0.55; }
        50% { transform: translateX(-50%) scale(0.9); opacity: 0.35; }
        100% { transform: translateX(-50%) scale(1); opacity: 0.55; }
    }

    /* ── Floor shadow ────────────────────────────── */
    .book-shadow {
        position: absolute;
        bottom: 0.5rem;
        left: 50%;
        width: 220px;
        height: 30px;
        background: rgba(0,0,0,0.55);
        filter: blur(18px);
        border-radius: 50%;
        animation: shadowPulse 6s ease-in-out infinite;
    }

    /* ── Info Section ────────────────────────────── */
    .section-label {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent-color);
        margin-bottom: 1rem;
    }

    .book-title {
        font-size: clamp(2.2rem, 4.5vw, 3.8rem);
        margin-bottom: 1.5rem;
        line-height: 1.1;
    }

    .highlight { color: var(--accent-color); }

    .book-desc {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-bottom: 2.5rem;
        max-width: 560px;
        line-height: 1.7;
    }

    /* Price */
    .price-comparison {
        display: flex;
        gap: 2rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        padding: 1.5rem 2rem;
        border-radius: 16px;
        margin-bottom: 2.5rem;
        align-items: center;
    }

    .price-box {
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(255,255,255,0.1);
        padding-right: 2rem;
        flex-shrink: 0;
    }

    .price-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
    }

    .price-value {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--accent-color);
        line-height: 1.1;
    }

    .comparison-text p { margin: 0; font-size: 0.95rem; }

    .comparison-punchline {
        margin-top: 0.4rem !important;
        font-size: 1rem !important;
        color: #fff;
    }

    .comparison-punchline strong { color: var(--accent-color); }

    /* Quotes */
    .quotes-slider { margin-bottom: 2.5rem; }

    .quotes-track {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .quote-item {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
    }

    .quote-mark {
        font-size: 2.5rem;
        line-height: 1;
        color: var(--accent-color);
        opacity: 0.35;
        font-family: serif;
        flex-shrink: 0;
    }

    .quote-item p {
        margin: 0;
        font-style: italic;
        color: var(--text-muted);
        font-size: 1rem;
        padding-top: 0.4rem;
    }

    /* Actions */
    .book-actions {
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .buy-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 30px;
        font-size: 1.05rem;
        box-shadow: 0 10px 30px rgba(255,200,0,0.18);
        white-space: nowrap;
    }

    .phone-label {
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .phone-label strong {
        color: #fff;
        margin-left: 4px;
    }

    /* ── Responsive ──────────────────────────────── */

    /* Tablet: shrink book a bit */
    @media (max-width: 1100px) {
        .book-visual-wrap {
            --bw: 220px;
            --bh: 314px;
            --bd: 34px;
        }
        .book-grid { gap: 3rem; }
    }

    /* Stack vertically below 900px */
    @media (max-width: 900px) {
        .book-grid {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 4rem;
        }

        .book-visual-wrap {
            --bw: 200px;
            --bh: 285px;
            --bd: 32px;
            padding-bottom: 2.5rem;
        }

        /* Slightly less tilt on tablet/mobile so more of the cover shows */
        .book { transform: rotateX(6deg) rotateY(-20deg); }
        .book:hover { transform: rotateX(3deg) rotateY(-10deg) translateY(-6px); }

        .book-desc { margin-left: auto; margin-right: auto; }

        .price-comparison {
            flex-direction: column;
            gap: 1rem;
            text-align: left;
        }

        .price-box {
            border-right: none;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-right: 0;
            padding-bottom: 1rem;
            width: 100%;
        }

        .quote-item { justify-content: center; }

        .book-actions {
            justify-content: center;
            flex-direction: column;
            gap: 1rem;
        }
    }

    /* Mobile */
    @media (max-width: 480px) {
        .recipe-book-section { padding: 5rem 0 7rem; }

        .book-visual-wrap {
            --bw: 170px;
            --bh: 242px;
            --bd: 28px;
            padding-bottom: 2rem;
        }

        .book { transform: rotateX(5deg) rotateY(-18deg); }
        .book:hover { transform: rotateX(2deg) rotateY(-9deg) translateY(-5px); }

        .book-shadow { width: 150px; height: 22px; }

        .book-title { font-size: 2rem; }
    }
</style>
